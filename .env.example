# 이 파일을 복사해 .env 로 저장하고 실제 값을 채우세요 (로컬 테스트용).
# GitHub Actions에서는 대신 Settings > Secrets and variables > Actions 에 동일한 이름으로 등록합니다.

# Google Gemini API 키 (무료 티어) - aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=

# Instagram Graph API - README.md의 "Meta 연동 준비" 섹션을 따라 발급
IG_USER_ID=
IG_ACCESS_TOKEN=
