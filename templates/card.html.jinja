<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&family=Gothic+A1:wght@800;900&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: {{ width }}px;
    height: {{ height }}px;
    overflow: hidden;
    font-family: {{ brand.body_font }};
    background: {{ brand.bg_color }};
    color: {{ brand.text_color }};
  }
  .card { width: 100%; height: 100%; position: relative; overflow: hidden; }
  .night-glow {
    position: absolute; left: 0; right: 0; bottom: 0; height: 520px;
    background-image: linear-gradient(to top, {{ 'rgba(255,107,214,0.13)' if kind == 'outro' else 'rgba(127,247,208,0.14)' }}, transparent 75%);
  }
  .chrome-text {
    background: linear-gradient(180deg, #FFFFFF 0%, {{ brand.primary_color }} 45%, {{ brand.accent_color }} 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @keyframes twinkle { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }
  .star { animation: twinkle 3.4s ease-in-out infinite; }
  .kicker {
    position: absolute; left: 76px; top: 96px;
    font-family: {{ brand.label_font }};
    font-weight: 700; font-size: 24px; letter-spacing: 5px;
    color: {{ brand.accent_color }};
  }
  .glass-panel {
    background: rgba(232, 228, 245, 0.06);
    border: 1px solid rgba(127, 247, 208, 0.35);
    border-radius: 18px;
    box-shadow: 0 0 0 1px rgba(255, 107, 214, 0.08), 0 20px 50px rgba(0, 0, 0, 0.35);
    padding: 46px 44px;
  }
  .neon-btn {
    box-shadow: 0 0 0 2px {{ brand.primary_color }}, 0 0 24px rgba(127, 247, 208, 0.55), 0 0 46px rgba(255, 107, 214, 0.35);
    background: #14101C;
    border-radius: 100px;
    padding: 40px 48px;
  }
  .brand-tag {
    position: absolute; left: 76px; bottom: 56px;
    font-family: {{ brand.body_font }};
    font-weight: 700; font-size: 22px; letter-spacing: 2px;
    color: {{ brand.primary_color }};
  }
  .pager {
    position: absolute; right: 76px; bottom: 56px;
    font-family: {{ brand.label_font }};
    font-weight: 700; font-size: 24px;
    color: {{ brand.primary_color }};
  }
</style>
</head>
<body>
{% macro star(x, y, size, color, delay, opacity) -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="-13 -13 26 26" style="position:absolute;left:{{ x }}px;top:{{ y }}px;animation-delay:{{ delay }}s;" class="star">
  <path d="M0,-11 C1,-2 2,-1 11,0 C2,1 1,2 0,11 C-1,2 -2,1 -11,0 C-2,-1 -1,-2 0,-11 Z" fill="{{ color }}" opacity="{{ opacity }}"/>
</svg>
{%- endmacro %}

{% macro owl_svg() -%}
