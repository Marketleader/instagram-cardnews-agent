  <g transform="rotate(-9 110 130)">
    <path d="M42 148 Q10 132 4 96 Q34 100 52 126 Z" fill="#B7A8E6" stroke="{{ brand.ink_color }}" stroke-width="4" stroke-linejoin="round"/>
    <path d="M178 152 Q206 160 204 188 Q180 184 176 158 Z" fill="#B7A8E6" stroke="{{ brand.ink_color }}" stroke-width="4" stroke-linejoin="round"/>
    <ellipse cx="92" cy="232" rx="11" ry="7" fill="#D9CFF3" stroke="{{ brand.ink_color }}" stroke-width="4"/>
    <ellipse cx="128" cy="232" rx="11" ry="7" fill="#D9CFF3" stroke="{{ brand.ink_color }}" stroke-width="4"/>
    <path d="M110 42 C 156 42 190 80 190 130 C 190 180 162 222 110 222 C 58 222 30 180 30 130 C 30 80 64 42 110 42 Z" fill="#D9CFF3" stroke="{{ brand.ink_color }}" stroke-width="5" stroke-linejoin="round"/>
    <ellipse cx="82" cy="34" rx="11" ry="17" transform="rotate(-16 82 34)" fill="#D9CFF3" stroke="{{ brand.ink_color }}" stroke-width="4"/>
    <ellipse cx="138" cy="34" rx="11" ry="17" transform="rotate(16 138 34)" fill="#D9CFF3" stroke="{{ brand.ink_color }}" stroke-width="4"/>
    <path d="M52 150 Q58 160 54 172" fill="none" stroke="{{ brand.ink_color }}" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
    <path d="M168 150 Q162 160 166 172" fill="none" stroke="{{ brand.ink_color }}" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
    <circle cx="80" cy="132" r="32" fill="#FFFFFF" stroke="{{ brand.ink_color }}" stroke-width="5"/>
    <circle cx="140" cy="132" r="32" fill="#FFFFFF" stroke="{{ brand.ink_color }}" stroke-width="5"/>
    <path d="M108 132 L112 132" stroke="{{ brand.ink_color }}" stroke-width="5" stroke-linecap="round"/>
    <path d="M50 126 L30 116" fill="none" stroke="{{ brand.ink_color }}" stroke-width="5" stroke-linecap="round"/>
    <path d="M170 126 L190 116" fill="none" stroke="{{ brand.ink_color }}" stroke-width="5" stroke-linecap="round"/>
    <circle cx="86" cy="132" r="10" fill="#241B33"/>
    <circle cx="146" cy="132" r="10" fill="#241B33"/>
    <circle cx="82" cy="128" r="3.2" fill="#FFFFFF"/>
    <circle cx="142" cy="128" r="3.2" fill="#FFFFFF"/>
    <path d="M110 154 L97 174 L110 190 L123 174 Z" fill="{{ brand.accent_color }}" stroke="{{ brand.ink_color }}" stroke-width="3.5" stroke-linejoin="round"/>
    <circle cx="52" cy="156" r="10" fill="{{ brand.accent_color }}" opacity="0.55"/>
    <circle cx="168" cy="156" r="10" fill="{{ brand.accent_color }}" opacity="0.55"/>
    <path d="M96 200 L110 208 L96 216 Z M124 200 L110 208 L124 216 Z" fill="#B7A8E6" stroke="{{ brand.ink_color }}" stroke-width="2.5" stroke-linejoin="round"/>
    <circle cx="110" cy="208" r="4.5" fill="{{ brand.gold_color }}" stroke="{{ brand.ink_color }}" stroke-width="1.5"/>
    <path d="M110,228 C110.7,220 111.5,218.8 120,218 C111.5,217.2 110.7,216 110,208 C109.3,216 108.5,217.2 100,218 C108.5,218.8 109.3,220 110,228 Z" fill="{{ brand.primary_color }}" stroke="{{ brand.ink_color }}" stroke-width="2" stroke-linejoin="round"/>
  </g>
</svg>
{%- endmacro %}

{% macro human_svg() -%}
<svg viewBox="0 0 220 260" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;">
  <g transform="rotate(-6 110 140)">
    <ellipse cx="92" cy="238" rx="13" ry="8" fill="{{ brand.ink_color }}"/>
    <ellipse cx="128" cy="238" rx="13" ry="8" fill="{{ brand.ink_color }}"/>
    <path d="M110 148 C 150 148 168 178 164 216 C 160 236 60 236 56 216 C 52 178 70 148 110 148 Z" fill="{{ brand.primary_color }}" stroke="{{ brand.ink_color }}" stroke-width="5" stroke-linejoin="round"/>
    <ellipse cx="58" cy="188" rx="16" ry="22" transform="rotate(18 58 188)" fill="{{ brand.primary_color }}" stroke="{{ brand.ink_color }}" stroke-width="4.5"/>
    <path d="M158 176 Q186 156 184 118" fill="none" stroke="{{ brand.primary_color }}" stroke-width="24" stroke-linecap="round"/>
    <path d="M158 176 Q186 156 184 118" fill="none" stroke="{{ brand.ink_color }}" stroke-width="4.5" stroke-linecap="round"/>
    <path d="M184 118 L188 66" stroke="{{ brand.ink_color }}" stroke-width="4" stroke-linecap="round"/>
    <path d="M188,52 C188.8,62 190,64 200,66 C190,68 188.8,70 188,80 C187.2,70 186,68 176,66 C186,64 187.2,62 188,52 Z" fill="{{ brand.gold_color }}" stroke="{{ brand.ink_color }}" stroke-width="2.5" stroke-linejoin="round"/>
    <circle cx="184" cy="112" r="12" fill="#FFD9B3" stroke="{{ brand.ink_color }}" stroke-width="4"/>
    <path d="M78 156 Q110 176 142 156 Q140 168 110 180 Q80 168 78 156 Z" fill="{{ brand.accent_color }}" stroke="{{ brand.ink_color }}" stroke-width="4" stroke-linejoin="round"/>
    <path d="M96 172 L90 210 L104 206 L100 172 Z" fill="{{ brand.accent_color }}" stroke="{{ brand.ink_color }}" stroke-width="3.5" stroke-linejoin="round"/>
    <circle cx="110" cy="108" r="66" fill="#FFD9B3" stroke="{{ brand.ink_color }}" stroke-width="5"/>
    <path d="M50 70 Q40 85 48 104 Q59 97 57 78 Z" fill="#4A3728" stroke="{{ brand.ink_color }}" stroke-width="3" stroke-linejoin="round"/>
    <path d="M170 70 Q180 85 172 104 Q161 97 163 78 Z" fill="#4A3728" stroke="{{ brand.ink_color }}" stroke-width="3" stroke-linejoin="round"/>
    <path d="M110 20 C 155 20 166 55 166 68 L 54 68 C 54 55 65 20 110 20 Z" fill="#C9BFE8" stroke="{{ brand.ink_color }}" stroke-width="5" stroke-linejoin="round"/>
    <path d="M112,6 C112.8,16 114,18 124,20 C114,22 112.8,24 112,34 C111.2,24 110,22 100,20 C110,18 111.2,16 112,6 Z" fill="{{ brand.gold_color }}" stroke="{{ brand.ink_color }}" stroke-width="2.5" stroke-linejoin="round"/>
    <path d="M64 68 Q64 92 78 90 Q86 97 96 89 Q104 97 114 89 Q122 97 132 89 Q142 97 150 90 Q156 92 156 68 Z" fill="#4A3728" stroke="{{ brand.ink_color }}" stroke-width="3" stroke-linejoin="round"/>
    <circle cx="82" cy="112" r="26" fill="#FFFFFF" stroke="{{ brand.ink_color }}" stroke-width="5"/>
    <circle cx="138" cy="112" r="26" fill="#FFFFFF" stroke="{{ brand.ink_color }}" stroke-width="5"/>
    <path d="M108 112 L112 112" stroke="{{ brand.ink_color }}" stroke-width="5" stroke-linecap="round"/>
    <path d="M56 108 L38 100" fill="none" stroke="{{ brand.ink_color }}" stroke-width="5" stroke-linecap="round"/>
    <path d="M164 108 L182 100" fill="none" stroke="{{ brand.ink_color }}" stroke-width="5" stroke-linecap="round"/>
    <circle cx="87" cy="112" r="8" fill="#241B33"/>
    <circle cx="143" cy="112" r="8" fill="#241B33"/>
    <circle cx="84" cy="109" r="2.8" fill="#FFFFFF"/>
    <circle cx="140" cy="109" r="2.8" fill="#FFFFFF"/>
    <circle cx="60" cy="128" r="9" fill="{{ brand.accent_color }}" opacity="0.55"/>
    <circle cx="160" cy="128" r="9" fill="{{ brand.accent_color }}" opacity="0.55"/>
    <path d="M106 128 Q110 132 114 128" fill="none" stroke="{{ brand.ink_color }}" stroke-width="3" stroke-linecap="round"/>
    <path d="M94 141 Q110 157 126 141" fill="none" stroke="{{ brand.ink_color }}" stroke-width="3.5" stroke-linecap="round"/>
  </g>
</svg>
{%- endmacro %}

{% macro mascot() -%}
  {% if brand.character == 'human' %}{{ human_svg() }}{% else %}{{ owl_svg() }}{% endif %}
{%- endmacro %}

<div class="card">
  <div class="night-glow"></div>

  {{ star(150, 230, 26, brand.text_color, 0, 0.7) }}
  {{ star(940, 170, 16, brand.primary_color, 0.8, 0.8) }}
  {{ star(210, 900, 14, brand.accent_color, 1.6, 0.7) }}
  {{ star(980, 980, 20, brand.text_color, 2.2, 0.6) }}

  {% if kind == 'cover' %}
    <div class="kicker">{{ kicker }}</div>
    <div class="chrome-text" style="position:absolute;left:76px;top:400px;width:928px;font-family:{{ brand.display_font }};font-weight:900;font-size:88px;line-height:1.28;letter-spacing:-1.5px;">{{ title | replace('\n', '<br>') | safe }}</div>

    {{ star(772 if brand.character != 'human' else 762, 718 if brand.character != 'human' else 700, 42, '#FFFFFF', 0, 1) }}

    <div style="position:absolute;right:60px;top:725px;width:175px;height:205px;filter:drop-shadow(0 10px 18px rgba(0,0,0,0.45));">
      {{ mascot() }}
    </div>

    {% if subtitle %}
    <div style="position:absolute;left:76px;top:960px;width:820px;font-family:{{ brand.body_font }};font-weight:600;font-size:30px;line-height:1.55;color:{{ brand.text_color }};">{{ subtitle | replace('\n', '<br>') | safe }}</div>
    {% endif %}

  {% elif kind == 'content' %}
    <div class="chrome-text" style="position:absolute;left:76px;top:90px;font-family:{{ brand.label_font }};font-weight:900;font-size:150px;letter-spacing:-2px;">{{ "%02d"|format(index) }}</div>
    <div style="position:absolute;left:76px;top:320px;width:928px;font-family:{{ brand.display_font }};font-weight:900;font-size:60px;line-height:1.32;color:{{ brand.text_color }};letter-spacing:-1px;">{{ title | replace('\n', '<br>') | safe }}</div>
    <div class="glass-panel" style="position:absolute;left:76px;top:600px;width:928px;">
      <div style="font-family:{{ brand.body_font }};font-weight:400;font-size:36px;line-height:1.75;color:{{ brand.text_color }};">{{ body }}</div>
    </div>
    <div style="position:absolute;right:60px;bottom:120px;width:96px;height:113px;filter:drop-shadow(0 8px 14px rgba(0,0,0,0.4));">
      {{ mascot() }}
    </div>

  {% elif kind == 'outro' %}
    <div class="chrome-text" style="position:absolute;left:76px;top:118px;width:928px;font-family:{{ brand.display_font }};font-weight:900;font-size:68px;line-height:1.32;letter-spacing:-1.5px;">{{ title | replace('\n', '<br>') | safe }}</div>
    <div class="glass-panel" style="position:absolute;left:76px;top:440px;width:928px;">
      <div style="font-family:{{ brand.body_font }};font-weight:400;font-size:33px;line-height:1.78;color:{{ brand.text_color }};">{{ body }}</div>
    </div>
    <div class="neon-btn" style="position:absolute;left:76px;top:900px;width:928px;">
      <span style="font-family:{{ brand.body_font }};font-weight:600;font-size:29px;line-height:1.6;color:{{ brand.text_color }};">{{ cta | replace('\n', '<br>') | safe }}</span>
    </div>
    <div style="position:absolute;right:60px;bottom:120px;width:96px;height:113px;filter:drop-shadow(0 8px 14px rgba(0,0,0,0.4));">
      {{ mascot() }}
    </div>
  {% endif %}

  <div class="brand-tag">{{ brand_tag }}</div>
  <div class="pager">{{ index_display }} / {{ total }}</div>
</div>
</body>
</html>
